+
+// AMP_TRACE_OPS attributes device time to the op that spent it, and AMP_NO_CUDA_GRAPH=1 runs
+// the nodes directly, because a captured graph replays as a single unit and cannot be
+// attributed per op. Measurement only. See ggml_backend_cuda_graph_compute.
+#define AMP_OPS_SLOTS 128
+// Plain arrays: nvcc's std::atomic<double> has no fetch_add, and this accumulates on the
+// single host thread that calls graph_compute, and is read once at exit.
+static double   g_amp_ops_us[AMP_OPS_SLOTS];
+static uint64_t g_amp_ops_n[AMP_OPS_SLOTS];
+static uint64_t g_amp_nodes = 0;   // every node, timed or not, so the bubble can be accounted for
+static uint64_t g_amp_timed = 0;   // nodes that actually got an event pair
+
+// Attribute by op alone for the report, and by op + a name stem for the detail, so which
+// matmuls dominate is visible rather than guessed at. The stem collapses the layer index
+// and any numeric suffix, e.g. "blk.12.ffn_gate_exps" -> "blk.##.ffn_gate_exps".
+#define AMP_OPS_DETAIL 512
+struct amp_ops_key { int op; char stem[64]; };
+static std::vector<amp_ops_key>           g_amp_detail_key;
+static std::vector<std::array<double, 2>> g_amp_detail_val;   // {us, count}
+
+static void amp_ops_stem(const char * name, char * out, size_t n) {
+    size_t j = 0;
+    for (const char * q = name; *q && j + 1 < n; ++q) {
+        if (*q >= '0' && *q <= '9') { out[j++] = '#'; while (*q >= '0' && *q <= '9') ++q; --q; continue; }
+        out[j++] = *q;
+    }
+    out[j] = 0;
+}
+
+static void amp_ops_add(int op, double ms) {
+    if (op < 0 || op >= AMP_OPS_SLOTS) return;
+    g_amp_ops_us[op] += ms * 1e3;
+    g_amp_ops_n[op]  += 1;
+}
+
+// Nodes with an empty name are common enough to matter (341 mul_mats per decode token on
+// this model) and they were the single largest unattributed item, so key them by the shapes
+// of the two source tensors instead. That identifies which projection a node is.
+static void amp_ops_shape_stem(const char * name, const ggml_tensor * a, const ggml_tensor * b,
+                               char * out, size_t n) {
+    if (name && name[0]) { amp_ops_stem(name, out, n); return; }
+    if (a && b && a->ne[0] && b->ne[0]) {
+        snprintf(out, n, "? %" PRId64 "x%" PRId64 " @ %" PRId64 "x%" PRId64 " %s",
+                 (int64_t) a->ne[0], (int64_t) a->ne[1], (int64_t) b->ne[0], (int64_t) b->ne[1],
+                 "mat");
+    } else {
+        amp_ops_stem(name ? name : "?", out, n);
+    }
+}
+
+static void amp_ops_add_named(int op, const char * name, double ms,
+                              const ggml_tensor * a = nullptr, const ggml_tensor * b = nullptr) {
+    char stem[64];
+    amp_ops_shape_stem(name, a, b, stem, sizeof(stem));
+    for (size_t i = 0; i < g_amp_detail_key.size(); i++) {
+        if (g_amp_detail_key[i].op == op && strcmp(g_amp_detail_key[i].stem, stem) == 0) {
+            g_amp_detail_val[i][0] += ms * 1e3;
+            g_amp_detail_val[i][1] += 1;
+            return;
+        }
+    }
+    if (g_amp_detail_key.size() < AMP_OPS_DETAIL) {
+        amp_ops_key k;
+        k.op = op;
+        snprintf(k.stem, sizeof(k.stem), "%s", stem);
+        g_amp_detail_key.push_back(k);
+        g_amp_detail_val.push_back({ms * 1e3, 1.0});
+    }
+}
+
+struct amp_ops_report {
+    ~amp_ops_report() {
+        if (!getenv("AMP_TRACE_OPS")) return;
+        std::vector<std::pair<double,int>> v;
+        double tot = 0.0;
+        for (int i = 0; i < AMP_OPS_SLOTS; i++) {
+            const double us = g_amp_ops_us[i];
+            if (us <= 0.0) continue;
+            v.push_back({us, i});
+            tot += us;
+        }
+        std::sort(v.rbegin(), v.rend());
+        fprintf(stderr, "[OPS] total device time %.3f ms over %llu nodes (%llu timed)\n", tot/1e3,
+                (unsigned long long) g_amp_nodes, (unsigned long long) g_amp_timed);
+        for (size_t i = 0; i < v.size() && i < 18; i++) {
+            fprintf(stderr, "[OPS] %9.3f ms  n=%-7llu %s\n", v[i].first/1e3,
+                    (unsigned long long) g_amp_ops_n[v[i].second],
+                    ggml_op_name((ggml_op) v[i].second));
+        }
+        std::vector<std::pair<double,size_t>> d;
+        for (size_t i = 0; i < g_amp_detail_key.size(); i++) d.push_back({g_amp_detail_val[i][0], i});
+        std::sort(d.rbegin(), d.rend());
+        fprintf(stderr, "[OPS] --- by tensor ---\n");
+        for (size_t i = 0; i < d.size() && i < 40; i++) {
+            const auto & k = g_amp_detail_key[d[i].second];
+            fprintf(stderr, "[OPS] %9.3f ms  n=%-7.0f %-16s %s\n", d[i].first/1e3,
+                    g_amp_detail_val[d[i].second][1], ggml_op_name((ggml_op) k.op), k.stem);
+        }
+    }
+};
+static amp_ops_report g_amp_ops_report;
